#include <iostream>
#include <string>
using namespace std;

struct Node
{
    string song;
    Node* next;
};

class Playlist
{
private:
    Node* head;

public:
    Playlist()
    {
        head = nullptr;
    }

    void addSong(string name)
    {
        Node* newNode = new Node;
        newNode->song = name;
        newNode->next = nullptr;

        if (head == nullptr)
        {
            head = newNode;
            return;
        }

        Node* temp = head;
        while (temp->next != nullptr)
        {
            temp = temp->next;
        }

        temp->next = newNode;
    }

    void removeSong(string name)
    {
        if (head == nullptr)
        {
            cout << "Playlist is empty\n";
            return;
        }

        if (head->song == name)
        {
            Node* temp = head;
            head = head->next;
            delete temp;
            cout << "Song removed\n";
            return;
        }

        Node* current = head;

        while (current->next != nullptr && current->next->song != name)
        {
            current = current->next;
        }

        if (current->next == nullptr)
        {
            cout << "Song not found\n";
            return;
        }

        Node* temp = current->next;
        current->next = temp->next;
        delete temp;

        cout << "Song removed\n";
    }

    void show()
    {
        if (head == nullptr)
        {
            cout << "Playlist is empty\n";
            return;
        }

        Node* temp = head;
        int i = 1;

        while (temp != nullptr)
        {
            cout << i << ". " << temp->song << endl;
            temp = temp->next;
            i++;
        }
    }
};

int main()
{
    Playlist p;
    int choice;
    string name;

    do
    {
        cout << "\n1. Add Song\n";
        cout << "2. Remove Song\n";
        cout << "3. Show Playlist\n";
        cout << "0. Exit\n";
        cout << "Choice: ";
        cin >> choice;
        cin.ignore();

        switch (choice)
        {
        case 1:
            cout << "Song Name: ";
            getline(cin, name);
            p.addSong(name);
            break;

        case 2:
            cout << "Song Name: ";
            getline(cin, name);
            p.removeSong(name);
            break;

        case 3:
            p.show();
            break;

        case 0:
            cout << "Good Bye\n";
            break;

        default:
            cout << "Invalid Choice\n";
        }

    } while (choice != 0);

    return 0;
}
